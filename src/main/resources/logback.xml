<configuration>
    <appender name="CONSOLA" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>%d{HH:mm:ss} %-5level %logger{20} - %msg%n</pattern></encoder>
    </appender>
    <appender name="ARCHIVO" class="ch.qos.logback.core.FileAppender">
        <file>logs/doncaffeto.log</file>
        <encoder><pattern>%d{dd/MM/yyyy HH:mm:ss} %-5level %logger{20} - %msg%n</pattern></encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="CONSOLA"/>
        <appender-ref ref="ARCHIVO"/>
    </root>
</configuration>
