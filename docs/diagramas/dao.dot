digraph DAO {
  rankdir=BT; fontname="Helvetica"; label="Patrón DAO"; labelloc=t; fontsize=18;
  node [shape=record, style=filled, fillcolor="#FFF3E0", color="#E65100", fontname="Helvetica", fontsize=10];
  edge [color="#BF360C", arrowhead=onormal, style=dashed];
  U [label="{«interface»\nUsuarioDAO|+ buscarPorUsername(username)\l}"];
  P [label="{«interface»\nProductoDAO|+ listarDisponibles()\l}"];
  M [label="{«interface»\nMesaDAO|+ listarLibres()\l}"];
  D [label="{«interface»\nPedidoDAO|+ registrar(pedido)\l+ listarPorFecha(fecha)\l+ listarDetalle(idPedido)\l+ cambiarEstado(id, estado, usuario)\l}"];
  UI [label="UsuarioDAOImpl", fillcolor="#FFCC80"]; PI [label="ProductoDAOImpl", fillcolor="#FFCC80"];
  MI [label="MesaDAOImpl", fillcolor="#FFCC80"]; DI [label="PedidoDAOImpl", fillcolor="#FFCC80"];
  UI -> U; PI -> P; MI -> M; DI -> D;
  C [label="Conexion\n(DriverManager + config.properties)", fillcolor="#FFFFFF"];
  BD [shape=cylinder, style=filled, fillcolor="#4E342E", fontcolor=white, label="MySQL"];
  edge [style=solid, arrowhead=vee, dir=back];
  C -> UI; C -> PI; C -> MI; C -> DI; BD -> C;
}
