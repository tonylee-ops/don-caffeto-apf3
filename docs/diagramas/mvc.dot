digraph MVC {
  rankdir=LR; fontname="Helvetica"; label="Arquitectura MVC - Don Caffeto"; labelloc=t; fontsize=18; nodesep=0.18;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, fillcolor="#FFF3E0", color="#E65100"];
  edge [color="#BF360C", fontname="Helvetica", fontsize=9, arrowsize=0.7];
  subgraph cluster_v { label="Paquete vista\nJFrame Forms"; style=filled; fillcolor="#FFE0B2";
    FrmLogin; FrmPrincipal; FrmMesas; FrmMesa; FrmPedido; FrmPedidos; FrmCocina; FrmCaja; FrmProductos; FrmUsuarios; FrmReportes; }
  subgraph cluster_c { label="Paquete controlador"; style=filled; fillcolor="#FFCC80";
    LoginController; PrincipalController; MesasController; MesaController; PedidoController; PedidosController; CocinaController; CajaController;
    ProductosController; UsuariosController; ReportesController; }
  subgraph cluster_m { label="Paquete services\n(reglas del negocio)"; style=filled; fillcolor="#FFB74D";
    Autorizacion [label="Autorizacion\n(permisos por rol)", fillcolor="#FFFFFF"];
    LoginService; PedidoService; CocinaService; PagoService; ProductoService; UsuarioService; ReporteService; }
  subgraph cluster_d { label="Paquete dao"; style=filled; fillcolor="#FFA726";
    DAO [label="7 interfaces DAO\n+ implementaciones MySQL\n(JDBC, PreparedStatement)"]; }
  BD [shape=cylinder, fillcolor="#4E342E", fontcolor=white, label="MySQL\ndon_caffeto"];
  FrmLogin -> LoginController; FrmPrincipal -> PrincipalController; FrmMesas -> MesasController; FrmMesa -> MesaController; FrmPedido -> PedidoController; FrmPedidos -> PedidosController;
  FrmCocina -> CocinaController; FrmCaja -> CajaController; FrmProductos -> ProductosController; FrmUsuarios -> UsuariosController; FrmReportes -> ReportesController;
  LoginController -> LoginService; MesasController -> PedidoService; MesaController -> PedidoService; PedidoController -> PedidoService; PedidosController -> PedidoService; CocinaController -> CocinaService;
  CajaController -> PagoService; ProductosController -> ProductoService; UsuariosController -> UsuarioService; ReportesController -> ReporteService;
  PedidoService -> Autorizacion [style=dashed]; PagoService -> Autorizacion [style=dashed];
  LoginService -> DAO; PedidoService -> DAO; CocinaService -> DAO; PagoService -> DAO; ProductoService -> DAO; UsuarioService -> DAO; ReporteService -> DAO;
  DAO -> BD [label="JDBC"];
}
