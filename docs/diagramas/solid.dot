digraph SOLID {
  rankdir=TB; fontname="Helvetica"; label="Principios SOLID aplicados"; labelloc=t; fontsize=18; ranksep=0.25;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, color="#E65100"];
  S [label="S · Responsabilidad única", fillcolor="#E65100", fontcolor=white];
  O [label="O · Abierto / cerrado", fillcolor="#EF6C00", fontcolor=white];
  L [label="L · Sustitución de Liskov", fillcolor="#F57C00", fontcolor=white];
  I [label="I · Segregación de interfaces", fillcolor="#FB8C00", fontcolor=white];
  D [label="D · Inversión de dependencias", fillcolor="#FF9800", fontcolor=white];
  node [fillcolor="#FFF3E0"];
  S1 [label="Cada capa hace una sola cosa: la vista dibuja,\nel controlador atiende eventos, el servicio valida,\nel DAO guarda en MySQL"];
  O1 [label="Para cambiar de base de datos se crea otra\nimplementación del DAO sin tocar los servicios"];
  L1 [label="Los servicios funcionan igual con los DAO de MySQL\no con los DAO falsos de las pruebas JUnit"];
  I1 [label="Un DAO pequeño por tema (usuarios, pedidos, pagos...)\nsolo con los métodos que se usan"];
  D1 [label="Los servicios reciben la interfaz DAO por el constructor;\nsolo la clase Servicios crea las clases MySQL"];
  {rank=same; S; S1} {rank=same; O; O1} {rank=same; L; L1} {rank=same; I; I1} {rank=same; D; D1}
  S -> S1; O -> O1; L -> L1; I -> I1; D -> D1; S -> O -> L -> I -> D [style=invis];
}
